{
  "name": "@rexadb/data-table",
  "version": "0.1.0",
  "description": "Database-ready React tables: a sortable, selectable, paged list table and a canvas data grid for editing database rows.",
  "author": "Rexa DB",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "react",
    "table",
    "data-table",
    "data-grid",
    "database",
    "virtualized",
    "glide-data-grid"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./grid": {
      "import": {
        "types": "./dist/grid/index.d.ts",
        "default": "./dist/grid/index.js"
      },
      "require": {
        "types": "./dist/grid/index.d.cts",
        "default": "./dist/grid/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && bun run build:css",
    "build:css": "tailwindcss -i src/styles/build.css -o dist/styles.css --minify && cp src/styles/theme.css dist/theme.css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "peerDependencies": {
    "@glideapps/glide-data-grid": ">=6.0.4-alpha24 <7",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@glideapps/glide-data-grid": {
      "optional": true
    }
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-virtual": "^3.14.13",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@glideapps/glide-data-grid": "6.0.4-alpha24",
    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/cli": "^4.1.18",
    "@types/bun": "^1.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "^19",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwindcss": "^4.1.18",
    "tsup": "^8.5.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/RexaDB/RexaDB"
}
